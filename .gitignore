node_modules/
.gradle/
*.iml
.DS_Store
__pycache__/
*.pyc

# build/ output is ignored everywhere except theme/build/, which is
# committed so consumers don't need Node to use the generated theme outputs.
build/
!theme/build/
!theme/build/**

# Secrets — never commit. Live service .env files live alongside the
# compose files on disk only; they are never tracked.
.env
.env.*
!.env.example
tv-launcher/local.properties
