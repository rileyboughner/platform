#!/bin/sh
set -eu

DOTFILES_TARGET="$HOME/.platform/dotfiles"
# shellcheck source=lib/theme-common.sh
. "$DOTFILES_TARGET/scripts/lib/theme-common.sh"

theme_clear_state

WALLPAPER="$HOME/.wallpaper"
if [ -e "$WALLPAPER" ]; then
    wal -i "$(realpath "$WALLPAPER")"
fi

theme_write_derived
theme_reload_all
