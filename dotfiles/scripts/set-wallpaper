#!/bin/sh

WALLPAPER="$1"

if [ -z "$WALLPAPER" ]; then
    echo "Usage: set-wallpaper <path-to-image>" >&2
    exit 1
fi

if [ ! -f "$WALLPAPER" ]; then
    echo "No such file: $WALLPAPER" >&2
    exit 1
fi

DOTFILES_TARGET="$HOME/.platform/dotfiles"
# shellcheck source=lib/theme-common.sh
. "$DOTFILES_TARGET/scripts/lib/theme-common.sh"

# Wait for hyprpaper IPC socket to be ready before issuing wallpaper commands
until [ -S "/run/user/$(id -u)/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.hyprpaper.sock" ]; do
    sleep 0.3
done

# Set wallpaper (hyprpaper v0.7+ handles load/unload automatically)
hyprctl hyprpaper wallpaper ",$WALLPAPER"

# Persist the chosen wallpaper so it survives restarts
ln -sf "$(realpath "$WALLPAPER")" "$HOME/.wallpaper"

# Generate Pywal colors from the new wallpaper
wal -i "$WALLPAPER"

# If a named theme is pinned, re-apply it now so it isn't clobbered by
# the wallpaper-driven colors `wal -i` just generated -- only the
# wallpaper image changes, the color palette stays fixed.
if theme_name=$(theme_active_name); then
    theme_apply "$theme_name"
fi

theme_write_derived
theme_reload_all
