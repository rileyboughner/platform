#!/bin/sh

WALLPAPER="$1"

if [ -z "$WALLPAPER" ]; then
    echo "Usage: set-wallpaper <path-to-image>" >&2
    exit 1
fi

if [ ! -f "$WALLPAPER" ]; then
    echo "No such file: $WALLPAPER" >&2
    exit 1
fi

# awww transition: super fast fade. One place to tweak.
SWWW_TRANSITION_TYPE="fade"
SWWW_TRANSITION_DURATION="0.2"
SWWW_TRANSITION_FPS="60"

DOTFILES_TARGET="$HOME/.platform/dotfiles"
# shellcheck source=lib/theme-common.sh
. "$DOTFILES_TARGET/scripts/lib/theme-common.sh"

# Repair a stale Hyprland session signature (shells that predate a
# compositor restart) before the hyprctl calls in the reload sequence
# below -- otherwise those reloads silently go nowhere while the
# symlink below still updates.
theme_ensure_hypr_session || true

# Resolve once: awww's daemon reads the file itself, so it needs an
# absolute path (a relative path would resolve against the daemon's
# working directory, not ours).
WALLPAPER_ABS="$(realpath "$WALLPAPER")"

# Wait for the awww daemon to answer before issuing wallpaper
# commands (bounded: at startup the daemon may still be coming up;
# if it never answers, awww img below fails loudly instead of
# hanging forever).
_i=0
until awww query >/dev/null 2>&1; do
    _i=$((_i + 1))
    [ "$_i" -ge 35 ] && break
    sleep 0.3
done

# Set wallpaper via awww with a super fast fade transition.
awww img "$WALLPAPER_ABS" \
    --transition-type "$SWWW_TRANSITION_TYPE" \
    --transition-duration "$SWWW_TRANSITION_DURATION" \
    --transition-fps "$SWWW_TRANSITION_FPS"

# Persist the chosen wallpaper so it survives restarts
ln -sf "$WALLPAPER_ABS" "$HOME/.wallpaper"

# Generate Pywal colors from the new wallpaper
wal -i "$WALLPAPER"

# If a named theme is pinned, re-apply it now so it isn't clobbered by
# the wallpaper-driven colors `wal -i` just generated -- only the
# wallpaper image changes, the color palette stays fixed.
if theme_name=$(theme_active_name); then
    theme_apply "$theme_name"
fi

theme_write_derived
theme_reload_all
