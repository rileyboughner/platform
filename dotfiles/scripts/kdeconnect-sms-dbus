#!/usr/bin/env bash
set -euo pipefail

# Bridges the KDE Connect SMS panel (quickshell) to kdeconnectd over D-Bus.
#
# D-Bus surface used below (service org.kde.kdeconnect, session bus), every
# path/interface/method/signal confirmed by reading kdeconnect-kde 26.04.3
# source (not guessed, not introspected live -- no paired device was
# available while building this):
#
#   /modules/kdeconnect                                org.kde.kdeconnect.daemon
#     devices(bb) -> as                 core/daemon.h:61 (also registers the
#                                        well-known name "org.kde.kdeconnect",
#                                        see core/daemon.cpp:72-73)
#
#   /modules/kdeconnect/devices/<id>                    org.kde.kdeconnect.device
#     Properties: name, isReachable, isPaired, supportedPlugins
#                                        core/device.h Q_PROPERTY block;
#                                        device.cpp:78 registers this path with
#                                        ExportScriptableContents, which is why
#                                        plain Q_PROPERTY is readable via
#                                        org.freedesktop.DBus.Properties
#
#   /modules/kdeconnect/devices/<id>                    org.kde.kdeconnect.device.conversations
#     (ConversationsDbusInterface is a QDBusAbstractAdaptor parented to the
#     Device object -- plugins/sms/conversationsdbusinterface.cpp:21 -- so it
#     lives at the DEVICE path, not the sms plugin's own /sms sub-path)
#     activeConversations() -> av                         .h:68
#     requestConversation(x threadId, i start, i end)      .h:78 (indices into
#                                                           the local cache;
#                                                           backfills from the
#                                                           phone and re-emits
#                                                           conversationUpdated
#                                                           for the full range
#                                                           either way -- see
#                                                           requestconversationworker.cpp)
#     replyToConversation(x threadId, s message, av urls)  .h:83
#     requestAllConversationThreads()                      .h:93
#     Signals: conversationCreated(v) conversationUpdated(v)
#              conversationLoaded(x,t) conversationRemoved(x)
#                                                           .h:112-129
#
# ConversationMessage wire struct (plugins/../models/conversationmessage.h
# operator<<, lines 225-232), decoded positionally below:
#   (i eventField, s body, a(s) addresses, x date, i type, i read,
#    x threadId, i uid, x subId, a(xsss) attachments)
#
# Contact names: there is no D-Bus method to resolve a phone number to a
# name -- the real kdeconnect-sms app does it in-process via KPeople
# (smsapp/smshelper.cpp). What *is* on disk is the vcard cache that
# kdeconnectd's own contacts plugin already writes automatically on every
# connection (plugins/contacts/contactsplugin.cpp: connected() ->
# synchronizeRemoteWithLocal(), vcardsPath = plugins/contacts/contactsplugin.cpp:25).
# `contacts` below only *reads* that existing cache -- it never triggers a
# sync itself.
#
# UNVERIFIED (no paired device to test against): exact `read` polarity
# (assumed Android Telephony convention: 0 = unread, 1 = read), and whether
# `busctl monitor` sees kdeconnectd's signals with no extra bus policy on a
# real desktop session (confirmed working against this machine's own
# session bus in a sandbox with no kdeconnectd running, so the mechanism
# itself -- busctl monitor --json=short on the user session bus -- is
# verified; kdeconnectd actually emitting on it is not).

SERVICE="org.kde.kdeconnect"
DAEMON_PATH="/modules/kdeconnect"
DAEMON_IFACE="org.kde.kdeconnect.daemon"
DEVICE_IFACE="org.kde.kdeconnect.device"
CONV_IFACE="org.kde.kdeconnect.device.conversations"
SMS_PLUGIN_ID="kdeconnect_sms"

die() {
    echo "kdeconnect-sms-dbus: $*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
Usage: kdeconnect-sms-dbus <command> [args]

Commands:
  status                              Print JSON {state, deviceId, deviceName}
  conversations <deviceId> [cached]   Print JSON array of latest-message-per-thread
                                       ("cached" skips the requestAllConversationThreads
                                       kick; the watch stream already delivers live
                                       updates, so refreshes must not re-burst)
  thread <deviceId> <threadId> <n> [start]
                                       Request <n> messages of a thread starting at index
                                       <start> (default 0, newest-first; async, arrives via watch)
  send <deviceId> <threadId> <text>   Send a reply in an existing thread (async)
  newsms <deviceId> <address> <text> Send a message starting a new thread (async)
  attachment <deviceId> <partId> <uniqueId>
                                      Request an attachment download; the daemon
                                      emits attachmentReceived(filePath, fileName)
                                      on `watch` when the file is ready (at once
                                      from its disk cache if already downloaded)
  watch <deviceId>                    Stream JSON-per-line conversation events until killed
  contacts <deviceId>                 Print JSON array of {number, name} from the synced vcard cache
EOF
}

devpath() { echo "/modules/kdeconnect/devices/$1"; }

# Calls a method with --json=short and prints only the reply payload JSON
# (busctl already prints just {"type":...,"data":[...]} for `call`).
bcall() {
    busctl --user --json=short call "$SERVICE" "$@"
}

device_property() {
    local id="$1" prop="$2"
    busctl --user --json=short get-property "$SERVICE" "$(devpath "$id")" "$DEVICE_IFACE" "$prop" 2>/dev/null \
        | jq -r '.data'
}

device_supported_plugins() {
    local id="$1"
    busctl --user --json=short get-property "$SERVICE" "$(devpath "$id")" "$DEVICE_IFACE" supportedPlugins 2>/dev/null \
        | jq -r '.data[]' 2>/dev/null || true
}

cmd_status() {
    local all_ids
    if ! all_ids=$(bcall "$DAEMON_PATH" "$DAEMON_IFACE" devices bb false false 2>/dev/null | jq -r '.data[0][]' 2>/dev/null); then
        printf '{"state":"no-daemon"}\n'
        return 0
    fi

    if [ -z "$all_ids" ]; then
        printf '{"state":"no-device"}\n'
        return 0
    fi

    local best_unreachable_id="" best_unreachable_name=""
    local best_unpaired_id="" best_unpaired_name=""
    local best_nosms_id="" best_nosms_name=""

    local id
    while IFS= read -r id; do
        [ -n "$id" ] || continue
        local paired reachable name
        paired=$(device_property "$id" isPaired)
        reachable=$(device_property "$id" isReachable)
        name=$(device_property "$id" name)

        if [ "$paired" != "true" ]; then
            [ -n "$best_unpaired_id" ] || { best_unpaired_id="$id"; best_unpaired_name="$name"; }
            continue
        fi

        if [ "$reachable" != "true" ]; then
            [ -n "$best_unreachable_id" ] || { best_unreachable_id="$id"; best_unreachable_name="$name"; }
            continue
        fi

        if device_supported_plugins "$id" | grep -qx "$SMS_PLUGIN_ID"; then
            printf '{"state":"ok","deviceId":%s,"deviceName":%s}\n' "$(jq -Rn --arg v "$id" '$v')" "$(jq -Rn --arg v "$name" '$v')"
            return 0
        fi

        [ -n "$best_nosms_id" ] || { best_nosms_id="$id"; best_nosms_name="$name"; }
    done <<<"$all_ids"

    if [ -n "$best_nosms_id" ]; then
        printf '{"state":"sms-disabled","deviceId":%s,"deviceName":%s}\n' "$(jq -Rn --arg v "$best_nosms_id" '$v')" "$(jq -Rn --arg v "$best_nosms_name" '$v')"
    elif [ -n "$best_unreachable_id" ]; then
        printf '{"state":"unreachable","deviceId":%s,"deviceName":%s}\n' "$(jq -Rn --arg v "$best_unreachable_id" '$v')" "$(jq -Rn --arg v "$best_unreachable_name" '$v')"
    elif [ -n "$best_unpaired_id" ]; then
        printf '{"state":"not-paired","deviceId":%s,"deviceName":%s}\n' "$(jq -Rn --arg v "$best_unpaired_id" '$v')" "$(jq -Rn --arg v "$best_unpaired_name" '$v')"
    else
        printf '{"state":"no-device"}\n'
    fi
}

# Shared jq filter: turns one raw ConversationMessage struct array ($m, per
# the wire layout documented at the top of this file) into our flat schema.
# Attachments forward partId/mime/uniqueId only -- index [2] is a base64
# blob (tens of KB per attachment) that the panel never needs; the file
# itself arrives via `attachment` + the attachmentReceived signal.
MESSAGE_FILTER='. as $m | {
    threadId: $m[6],
    uid: $m[7],
    body: $m[1],
    date: $m[3],
    type: $m[4],
    read: $m[5],
    subId: $m[8],
    addresses: ($m[2] | map(.[0])),
    attachments: (($m[9] // []) | map({partId: .[0], mime: .[1], uniqueId: .[3]}))
}'

cmd_conversations() {
    local id="${1:-}" mode="${2:-}"
    [ -n "$id" ] || { usage; exit 1; }

    # Kick the remote for anything newer than what's cached; the reply (if
    # any) arrives as conversationCreated/conversationUpdated on `watch`,
    # not here -- this call itself returns void. Skipped in "cached" mode:
    # refreshes read the local cache only, since the watch stream already
    # delivers live updates and a re-kick would re-burst every thread.
    if [ "$mode" != "cached" ]; then
        bcall "$(devpath "$id")" "$CONV_IFACE" requestAllConversationThreads >/dev/null 2>&1 || true
    fi

    bcall "$(devpath "$id")" "$CONV_IFACE" activeConversations \
        | jq -c '.data[0][] | .data' \
        | jq -c "$MESSAGE_FILTER" \
        | jq -s -c .
}

cmd_thread() {
    local id="${1:-}" threadId="${2:-}" count="${3:-50}" start="${4:-0}"
    [ -n "$id" ] && [ -n "$threadId" ] || { usage; exit 1; }
    bcall "$(devpath "$id")" "$CONV_IFACE" requestConversation xii "$threadId" "$start" "$((start + count))" >/dev/null
}

cmd_send() {
    local id="${1:-}" threadId="${2:-}"
    [ -n "$id" ] && [ -n "$threadId" ] || { usage; exit 1; }
    shift 2
    local text="$*"
    [ -n "$text" ] || die "empty message"
    bcall "$(devpath "$id")" "$CONV_IFACE" replyToConversation xsav "$threadId" "$text" 0 >/dev/null
}

cmd_newsms() {
    local id="${1:-}" address="${2:-}"
    [ -n "$id" ] && [ -n "$address" ] || { usage; exit 1; }
    shift 2
    local text="$*"
    [ -n "$text" ] || die "empty message"
    # sendWithoutConversation takes an array of variants, each holding a
    # one-string ConversationAddress struct: busctl shape `avsav 1 "(s)"
    # "<address>" "<text>" 0`. Verified live 2026-11-18 (empty-address and
    # undeliverable-address probes both accepted with no D-Bus error).
    bcall "$(devpath "$id")" "$CONV_IFACE" sendWithoutConversation avsav 1 "(s)" "$address" "$text" 0 >/dev/null
}

cmd_attachment() {
    local id="${1:-}" part="${2:-}" uniq="${3:-}"
    [ -n "$id" ] && [ -n "$part" ] && [ -n "$uniq" ] || { usage; exit 1; }
    # Fire-and-forget: the daemon serves the file from its disk cache or
    # downloads it from the phone, then emits attachmentReceived on `watch`.
    bcall "$(devpath "$id")" "$CONV_IFACE" requestAttachmentFile xs "$part" "$uniq" >/dev/null
}

cmd_watch() {
    local id="${1:-}"
    [ -n "$id" ] || { usage; exit 1; }
    local path
    path=$(devpath "$id")

    # --unbuffered on both ends: this feeds a long-lived QML Process that
    # reads stdout line-by-line, so nothing may sit in a stdio buffer.
    stdbuf -oL busctl --user --json=short monitor "$SERVICE" 2>/dev/null \
        | jq -c --unbuffered --arg path "$path" --arg iface "$CONV_IFACE" '
            select(.type == "signal" and .path == $path and .interface == $iface) |
            if .member == "conversationCreated" or .member == "conversationUpdated" then
                (.payload.data[0].data) as $m |
                if ($m[6] == null) or ($m[7] == null) then
                    empty
                else
                    {
                        signal: .member,
                        threadId: $m[6], uid: $m[7], body: $m[1], date: $m[3],
                        type: $m[4], read: $m[5], subId: $m[8],
                        addresses: ($m[2] | map(.[0])),
                        attachments: (($m[9] // []) | map({partId: .[0], mime: .[1], uniqueId: .[3]}))
                    }
                end
            elif .member == "attachmentReceived" then
                {signal: "attachmentReceived", filePath: .payload.data[0], fileName: .payload.data[1]}
            elif .member == "conversationLoaded" then
                if (.payload.data[0] == null) then
                    empty
                else
                    {signal: "conversationLoaded", threadId: .payload.data[0], count: .payload.data[1]}
                end
            elif .member == "conversationRemoved" then
                {signal: "conversationRemoved", threadId: .payload.data[0]}
            else
                empty
            end
        '
}

# Reads whatever vcards kdeconnectd's own contacts plugin has already
# synced for this device (see header comment) and prints {number, name}
# pairs. Numbers are reduced to their last 10 digits so "+15551234567",
# "15551234567" and "5551234567" all collapse to one key -- a US/CA-centric
# heuristic, unverified against a real contact list.
cmd_contacts() {
    local id="${1:-}"
    [ -n "$id" ] || { usage; exit 1; }

    local data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
    local vdir="$data_home/kpeoplevcard/kdeconnect-$id"
    [ -d "$vdir" ] || { echo "[]"; return 0; }

    # One awk pass over every vcard (FN + TELs per file), one jq pass to
    # build the array. The old loop spawned a jq per phone number (~3.5s
    # for 333 cards on the laptop); this is one scan plus one JSON encode.
    # Fields are separated by \x1f (unit separator), which cannot appear
    # in a vCard FN line; jq splits on the same character (\u001f).
    { awk '
        function flush() {
            if (name == "") return
            for (i = 1; i <= ntel; i++) print tels[i] "\x1f" name
        }
        FNR == 1 { flush(); name = ""; ntel = 0; delete tels }
        /^FN[;:]/ && name == "" {
            sub(/^FN[^:]*:/, ""); gsub(/\r/, ""); name = $0
        }
        /^TEL[^:]*:/ {
            line = $0; sub(/^TEL[^:]*:/, "", line); gsub(/\r/, "", line)
            gsub(/[^0-9]/, "", line)
            if (length(line) > 0) tels[++ntel] = substr(line, length(line) - 9)
        }
        END { flush() }
    ' "$vdir"/*.vcf "$vdir"/*.vcard 2>/dev/null || true; } \
        | jq -R -s -c 'split("\n") | map(select(length > 0) | split("\u001f") | {number: .[0], name: .[1]})'
}

case "${1:-}" in
    status) shift; cmd_status "$@" ;;
    conversations) shift; cmd_conversations "$@" ;;
    thread) shift; cmd_thread "$@" ;;
    send) shift; cmd_send "$@" ;;
    newsms) shift; cmd_newsms "$@" ;;
    attachment) shift; cmd_attachment "$@" ;;
    watch) shift; cmd_watch "$@" ;;
    contacts) shift; cmd_contacts "$@" ;;
    *) usage; exit 1 ;;
esac
