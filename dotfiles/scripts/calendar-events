#!/usr/bin/env python3
"""calendar-events: print calendar events from Nextcloud CalDAV as JSON.

Reads Nextcloud credentials from /run/agenix/nextcloud-caldav
(line 1 = username, line 2 = app password).

Commands:
  events [days]  Print JSON array of events from today for <days> days
                 (default 2: today + tomorrow).
                 Each item: {date, time, title, calendar}
                 date is YYYY-MM-DD, time is HH:MM (24h) or "" for all-day.
  next           Print a single JSON object for the next upcoming event
                 within the next 7 days, or {} when there is none.
  refresh        Fetch live from Nextcloud and update the cache (for a
                 background timer). Prints nothing on success.
  add "Title" [date] [time] [duration]
                 Create an event on the "Events" calendar. date is
                 YYYY-MM-DD (default today); time is HH:MM (default
                 all-day); duration is minutes (default 60).
  delete <uid>   Delete the event with that UID (from any calendar).

Results are cached for 10 minutes so the panel opens instantly; a stale
cache triggers one live fetch and then serves from the fresh cache.
"""
import base64
import json
import os
import re
import sys
import time
import urllib.request
import urllib.error
from datetime import datetime, timedelta, date
from zoneinfo import ZoneInfo

SECRET_FILE = "/run/agenix/nextcloud-caldav"
BASE_URL = "https://cloud.rileyboughner.dev"
LOCAL_TZ = ZoneInfo("America/New_York")

# Cache: pre-loaded events so the panel opens instantly instead of doing
# live CalDAV requests every time. Refreshed in the background and on stale reads.
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "calendar-events")
CACHE_FILE = os.path.join(CACHE_DIR, "events.json")
CACHE_TTL = 600  # seconds (10 minutes)
CACHE_DAYS = 30  # cache a 30-day window so any shorter query is served from it

# Calendars that hold tasks, not events; skip them.
SKIP_CALENDARS = {"shopping list", "tasks"}


def die(msg):
    print(f"calendar-events: {msg}", file=sys.stderr)
    sys.exit(1)


def load_credentials():
    try:
        with open(SECRET_FILE) as f:
            lines = [ln.strip() for ln in f if ln.strip()]
    except FileNotFoundError:
        die(f"no credentials at {SECRET_FILE} (create a Nextcloud app password and store it with `boner secrets update nextcloud-caldav`)")
    if len(lines) < 2:
        die(f"{SECRET_FILE} needs two lines: username, then app password")
    return lines[0], lines[1]


def dav_request(user, password, method, url, body=None, headers=None):
    req = urllib.request.Request(url, data=body, method=method)
    # Cloudflare blocks the default Python-urllib User-Agent (403), so use a
    # browser-like one.
    req.add_header("User-Agent", "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0")
    token = base64.b64encode(f"{user}:{password}".encode()).decode()
    req.add_header("Authorization", f"Basic {token}")
    if headers:
        for k, v in headers.items():
            req.add_header(k, v)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status, resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        die(f"CalDAV {method} {url} failed: HTTP {e.code}")
    except urllib.error.URLError as e:
        die(f"CalDAV request failed (network unreachable?): {e.reason}")


def list_calendars(user, password):
    """Return [(href, displayname)] for the user's calendars."""
    url = f"{BASE_URL}/remote.php/dav/calendars/{user}/"
    body = (
        '<?xml version="1.0" encoding="utf-8"?>'
        '<d:propfind xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav">'
        "<d:prop><d:displayname/><d:resourcetype/></d:prop></d:propfind>"
    ).encode()
    _, resp = dav_request(user, password, "PROPFIND", url, body,
                         {"Content-Type": "application/xml", "Depth": "1"})
    calendars = []
    for m in re.finditer(r"<d:response>(.*?)</d:response>", resp, re.S):
        block = m.group(1)
        href = re.search(r"<d:href>([^<]+)</d:href>", block)
        name = re.search(r"<d:displayname>([^<]*)</d:displayname>", block)
        if href and name and ":calendar" in block:
            calendars.append((href.group(1), name.group(1)))
    return calendars


def query_events(user, password, cal_href, start_utc, end_utc):
    """Return raw ICS text for events in [start_utc, end_utc) in one calendar."""
    fmt = "%Y%m%dT%H%M%SZ"
    body = (
        '<?xml version="1.0" encoding="utf-8"?>'
        '<c:calendar-query xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav">'
        "<d:prop><d:getetag/><c:calendar-data/></d:prop>"
        "<c:filter><c:comp-filter name=\"VCALENDAR\">"
        "<c:comp-filter name=\"VEVENT\">"
        f"<c:time-range start=\"{start_utc.strftime(fmt)}\" end=\"{end_utc.strftime(fmt)}\"/>"
        "</c:comp-filter></c:comp-filter></c:filter>"
        "</c:calendar-query>"
    ).encode()
    url = f"{BASE_URL}{cal_href}"
    _, resp = dav_request(user, password, "REPORT", url, body,
                         {"Content-Type": "application/xml", "Depth": "1"})
    return re.findall(r"<[^:>]+:calendar-data>(.*?)</[^:>]+:calendar-data>", resp, re.S)


def unfold(ics):
    """Unfold folded ICS lines (continuation lines start with space/tab)."""
    out = []
    for line in ics.splitlines():
        if line[:1] in (" ", "\t") and out:
            out[-1] += line[1:]
        else:
            out.append(line)
    return out


def parse_dtstart(value, params):
    """Return (date_str, time_str) in local time for a DTSTART value."""
    if params.get("VALUE") == "DATE" or re.fullmatch(r"\d{8}", value):
        d = datetime.strptime(value, "%Y%m%d").date()
        return d.isoformat(), ""
    # Datetime: either UTC (Z) or with a TZID.
    if value.endswith("Z"):
        dt = datetime.strptime(value, "%Y%m%dT%H%M%SZ").replace(tzinfo=ZoneInfo("UTC"))
    else:
        tzid = params.get("TZID", "America/New_York")
        try:
            tz = ZoneInfo(tzid)
        except Exception:
            tz = LOCAL_TZ
        dt = datetime.strptime(value, "%Y%m%dT%H%M%S").replace(tzinfo=tz)
    local = dt.astimezone(LOCAL_TZ)
    return local.date().isoformat(), local.strftime("%H:%M")


def parse_events(ics_text, calendar_name):
    """Extract {date, time, title, calendar} dicts from one calendar's ICS."""
    events = []
    for block in re.findall(r"BEGIN:VEVENT(.*?)END:VEVENT", ics_text, re.S):
        props = {}
        for line in unfold(block):
            if ":" not in line:
                continue
            keypart, _, val = line.partition(":")
            parts = keypart.split(";")
            name = parts[0]
            params = {}
            for p in parts[1:]:
                if "=" in p:
                    k, _, v = p.partition("=")
                    params[k] = v
            props.setdefault(name, []).append((params, val))
        if "DTSTART" not in props or "SUMMARY" not in props:
            continue
        if "STATUS" in props and props["STATUS"][0][1].upper() == "CANCELLED":
            continue
        params, val = props["DTSTART"][0]
        date_str, time_str = parse_dtstart(val, params)
        title = props["SUMMARY"][0][1].replace("\\,", ",").replace("\\;", ";").replace("\\n", " ")
        uid = props["UID"][0][1] if "UID" in props else ""
        events.append({"date": date_str, "time": time_str,
                       "title": title, "calendar": calendar_name, "uid": uid})
    return events


def load_cache():
    """Return cached events list if the cache exists and is fresh, else None."""
    try:
        with open(CACHE_FILE) as f:
            data = json.load(f)
        fetched_at = data.get("fetched_at", 0)
        events = data.get("events", [])
        if time.time() - fetched_at > CACHE_TTL:
            return None
        if not isinstance(events, list):
            return None
        return events
    except (OSError, ValueError, KeyError):
        return None


def save_cache(events):
    """Write events to the cache file (best effort; never fails the command)."""
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = CACHE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"fetched_at": time.time(), "events": events}, f)
        os.replace(tmp, CACHE_FILE)
    except OSError:
        pass


def fetch_live(days):
    """Fetch events live from Nextcloud for the next <days> days."""
    user, password = load_credentials()
    now_local = datetime.now(LOCAL_TZ)
    start_local = now_local.replace(hour=0, minute=0, second=0, microsecond=0)
    end_local = start_local + timedelta(days=days)
    start_utc = start_local.astimezone(ZoneInfo("UTC"))
    end_utc = end_local.astimezone(ZoneInfo("UTC"))

    all_events = []
    for href, name in list_calendars(user, password):
        if name.strip().lower() in SKIP_CALENDARS:
            continue
        for ics in query_events(user, password, href, start_utc, end_utc):
            all_events.append((name, ics))
    events = []
    for name, ics in all_events:
        events.extend(parse_events(ics, name))
    events.sort(key=lambda e: (e["date"], e["time"] or "99:99", e["title"]))
    return events


def _in_window(events, days):
    """Filter an event list to [today, today+days)."""
    today = datetime.now(LOCAL_TZ).date()
    end = today + timedelta(days=days)
    today_s = today.isoformat()
    end_s = end.isoformat()
    return [e for e in events if today_s <= e["date"] < end_s]


def fetch_events(days):
    """Return events for the next <days> days, from cache when fresh."""
    if days <= CACHE_DAYS:
        cached = load_cache()
        if cached is not None:
            return _in_window(cached, days)
        events = fetch_live(CACHE_DAYS)
        save_cache(events)
        return _in_window(events, days)
    return fetch_live(days)


def find_calendar(user, password, name):
    """Return the href of the calendar whose display name matches (case-insensitive), or None."""
    for href, cal_name in list_calendars(user, password):
        if cal_name.strip().lower() == name.strip().lower():
            return href
    return None


def _ics_escape(text):
    return text.replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,").replace("\n", "\\n")


def cmd_add(args):
    """Create an event: add "Title" [date YYYY-MM-DD] [time HH:MM] [duration_minutes].

    date defaults to today; time empty/absent means all-day; duration
    defaults to 60 minutes for timed events. Adds to the "Events" calendar.
    Prints the created event as JSON.
    """
    import uuid
    if not args:
        die('usage: calendar-events add "Title" [date] [time] [duration_minutes]')
    title = args[0]
    date_s = args[1] if len(args) > 1 else datetime.now(LOCAL_TZ).date().isoformat()
    time_s = args[2] if len(args) > 2 else ""
    duration = 60
    if len(args) > 3:
        try:
            duration = int(args[3])
        except ValueError:
            die(f"bad duration: {args[3]}")
    try:
        d = date.fromisoformat(date_s)
    except ValueError:
        die(f"bad date: {date_s} (use YYYY-MM-DD)")
    uid = f"{uuid.uuid4()}@calendar-events"
    now_utc = datetime.now(ZoneInfo("UTC")).strftime("%Y%m%dT%H%M%SZ")
    if time_s:
        try:
            hh, mm = time_s.split(":")
            start_local = datetime(d.year, d.month, d.day, int(hh), int(mm), tzinfo=LOCAL_TZ)
        except ValueError:
            die(f"bad time: {time_s} (use HH:MM)")
        end_local = start_local + timedelta(minutes=duration)
        start_s = start_local.astimezone(ZoneInfo("UTC")).strftime("%Y%m%dT%H%M%SZ")
        end_s = end_local.astimezone(ZoneInfo("UTC")).strftime("%Y%m%dT%H%M%SZ")
        dtstart = f"DTSTART:{start_s}"
        dtend = f"DTEND:{end_s}"
        out_time = time_s
    else:
        dtstart = f"DTSTART;VALUE=DATE:{d.strftime('%Y%m%d')}"
        dtend = f"DTEND;VALUE=DATE:{(d + timedelta(days=1)).strftime('%Y%m%d')}"
        out_time = ""
    ics = (
        "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//calendar-events//EN\r\n"
        "BEGIN:VEVENT\r\n"
        f"UID:{uid}\r\nDTSTAMP:{now_utc}\r\n"
        f"{dtstart}\r\n{dtend}\r\nSUMMARY:{_ics_escape(title)}\r\n"
        "END:VEVENT\r\nEND:VCALENDAR\r\n"
    )
    user, password = load_credentials()
    href = find_calendar(user, password, "Events")
    if href is None:
        die('no calendar named "Events" found')
    url = f"{BASE_URL}{href}{uid}.ics"
    dav_request(user, password, "PUT", url, ics.encode(),
                {"Content-Type": "text/calendar; charset=utf-8"})
    # Invalidate the cache so the new event shows up on the next read.
    try:
        os.remove(CACHE_FILE)
    except OSError:
        pass
    print(json.dumps({"date": date_s, "time": out_time, "title": title, "calendar": "Events", "uid": uid}))


def cmd_delete(args):
    """Delete an event by UID: delete <uid>. Searches all calendars for it."""
    if not args:
        die("usage: calendar-events delete <uid>")
    uid = args[0]
    user, password = load_credentials()
    for href, name in list_calendars(user, password):
        if name.strip().lower() in SKIP_CALENDARS:
            continue
        url = f"{BASE_URL}{href}{uid}.ics"
        # Probe with a HEAD-like GET; a 404 means it is not in this calendar.
        req = urllib.request.Request(url, method="GET")
        req.add_header("User-Agent", "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0")
        token = base64.b64encode(f"{user}:{password}".encode()).decode()
        req.add_header("Authorization", f"Basic {token}")
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                resp.read()
        except urllib.error.HTTPError as e:
            if e.code == 404:
                continue
            die(f"CalDAV GET {url} failed: HTTP {e.code}")
        except urllib.error.URLError as e:
            die(f"CalDAV request failed (network unreachable?): {e.reason}")
        dav_request(user, password, "DELETE", url)
        try:
            os.remove(CACHE_FILE)
        except OSError:
            pass
        print(json.dumps({"deleted": uid, "calendar": name}))
        return
    die(f"no event with UID {uid} found")


def cmd_refresh():
    """Force a live fetch and update the cache (for a background timer)."""
    events = fetch_live(CACHE_DAYS)
    save_cache(events)


def cmd_events(args):
    days = 2
    if args:
        try:
            days = int(args[0])
        except ValueError:
            die(f"bad days value: {args[0]}")
    print(json.dumps(fetch_events(days)))


def cmd_next():
    events = fetch_events(7)
    now_local = datetime.now(LOCAL_TZ)
    today = now_local.date().isoformat()
    now_hm = now_local.strftime("%H:%M")
    for e in events:
        if e["date"] > today or (e["date"] == today and (not e["time"] or e["time"] >= now_hm)):
            print(json.dumps(e))
            return
    print("{}")


def usage():
    print(__doc__.strip().split("\n\n", 1)[0], file=sys.stderr)
    print("Usage: calendar-events <events [days] | next | refresh | add \"Title\" [date] [time] [duration] | delete <uid>>", file=sys.stderr)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "events":
        cmd_events(sys.argv[2:])
    elif cmd == "next":
        cmd_next()
    elif cmd == "refresh":
        cmd_refresh()
    elif cmd == "add":
        cmd_add(sys.argv[2:])
    elif cmd == "delete":
        cmd_delete(sys.argv[2:])
    else:
        usage()
        sys.exit(1)
