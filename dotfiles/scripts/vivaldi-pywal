#!/usr/bin/env python3
"""Sync pywal colors into a Vivaldi theme.

Reads ~/.cache/wal/colors.json, builds (or updates) a "Pywal" theme in
Vivaldi's Preferences, and sets it as the active theme for both dark and
light mode.

Vivaldi must be CLOSED when this runs. Vivaldi holds Preferences in memory
and rewrites the file on exit, so edits made while it is running are lost.
If Vivaldi is running, this script exits without changing anything.

Usage: vivaldi-pywal [--apply] [--quiet]
  --apply   also (re)launch Vivaldi after updating the theme
  --quiet   when Vivaldi is running, exit silently with status 0 instead
            of warning (for hooks that run on every theme change)
"""
import json
import os
import shutil
import subprocess
import sys

WAL_COLORS = os.path.expanduser("~/.cache/wal/colors.json")
PREFS = os.path.expanduser("~/.config/vivaldi/Default/Preferences")
THEME_ID = "Pywal"
THEME_NAME = "Pywal"


def vivaldi_running():
    r = subprocess.run(["pgrep", "-x", "vivaldi-bin"],
                       capture_output=True, text=True)
    return r.returncode == 0


def load_wal():
    with open(WAL_COLORS) as f:
        return json.load(f)


def build_theme(wal):
    special = wal.get("special", {})
    colors = wal.get("colors", {})
    bg = special.get("background", colors.get("color0", "#0b0b0c"))
    fg = special.get("foreground", colors.get("color15", "#e6e6e6"))
    # Accent: a light gray that reads against the dark background.
    accent = colors.get("color7", colors.get("color4", "#cfcfcf"))
    # Highlight: a mid gray for selections / hover states.
    highlight = colors.get("color1", colors.get("color8", "#5e5e5e"))
    return {
        "accentFromPage": False,
        "accentOnWindow": False,
        "accentSaturationLimit": 1,
        "alpha": 0.4,
        "backgroundImage": "",
        "backgroundPosition": "stretch",
        "backgroundSource": "",
        "blur": 6,
        "colorAccentBg": accent,
        "colorBg": bg,
        "colorFg": fg,
        "colorHighlightBg": highlight,
        "colorPosition": "unified",
        "colorWindowBg": bg,
        "contrast": 0,
        "engineVersion": 1,
        "id": THEME_ID,
        "name": THEME_NAME,
        "preferSystemAccent": False,
        "radius": 8,
        "transparencyTabBar": False,
        "transparencyTabs": False,
        "url": "",
        "version": 1,
    }


def main():
    quiet = "--quiet" in sys.argv
    if vivaldi_running():
        if not quiet:
            print("Vivaldi is running. Close it first, then run vivaldi-pywal again.")
            print("Edits made while Vivaldi runs are overwritten when it exits.")
        return 0 if quiet else 1

    if not os.path.exists(WAL_COLORS):
        print(f"No pywal colors found at {WAL_COLORS}. Run wal first.")
        return 1
    if not os.path.exists(PREFS):
        print(f"No Vivaldi Preferences found at {PREFS}.")
        return 1

    wal = load_wal()
    theme = build_theme(wal)

    with open(PREFS) as f:
        prefs = json.load(f)

    vivaldi = prefs.setdefault("vivaldi", {})
    themes = vivaldi.setdefault("themes", {}).setdefault("system", [])

    # Replace the existing Pywal theme, or append it.
    for i, t in enumerate(themes):
        if t.get("id") == THEME_ID:
            themes[i] = theme
            break
    else:
        themes.append(theme)

    # Make Pywal the active theme for both dark and light.
    sched = vivaldi.setdefault("theme", {}).setdefault("schedule", {})
    sched["o_s"] = {"dark": THEME_ID, "light": THEME_ID}

    # Backup, then write.
    shutil.copy2(PREFS, PREFS + ".bak")
    with open(PREFS, "w") as f:
        json.dump(prefs, f)

    print(f"Pywal theme applied: bg={theme['colorBg']} fg={theme['colorFg']} "
          f"accent={theme['colorAccentBg']} highlight={theme['colorHighlightBg']}")

    if "--apply" in sys.argv:
        subprocess.Popen(["vivaldi"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("Vivaldi relaunched.")
    else:
        print("Open Vivaldi to see it.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
