#!/usr/bin/env bash
set -euo pipefail

DOTFILES_TARGET="$HOME/.platform/dotfiles"
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(dirname "$SCRIPT_DIR")

# Fall back to nix-shell only for deps that are actually missing (e.g. a
# brand new machine, before its first nixos-rebuild has applied these as
# systemPackages). Unconditionally wrapping the whole script in nix-shell
# (as this used to) pays its ~0.3-1s nixpkgs-evaluation cost on every
# single invocation, which is most of why `boner` felt slow to run at all
# on an already set-up system. virt-viewer is deliberately left out here -
# see cmd_vm, which is the only command that needs it.
missing=()
for bin in stow git jq curl; do
    command -v "$bin" >/dev/null 2>&1 || missing+=("$bin")
done
if [ "${#missing[@]}" -gt 0 ]; then
    printf -v _relaunch '%q ' bash "$0" "$@"
    exec nix-shell -p "${missing[@]}" --run "$_relaunch"
fi

# qBittorrent (manual torrents) + TV cast.
# Credentials live in the agenix secret decrypted to $QBIT_SECRET_FILE
# (two lines: username, password). BONER_QBIT_SECRET overrides the path,
# which is only meant for testing — never point it at a committed file.
QBIT_SECRET_FILE="${BONER_QBIT_SECRET:-/run/agenix/qbittorrent}"
QBIT_HOSTS=("http://192.168.1.2:8082" "http://100.124.77.118:8082")
QBIT_CATEGORY="boner"
QBIT_MANUAL_SAVEPATH="/torrents/manual"
QBIT_CONTAINER_TORRENTS="/torrents"
QBIT_HOST_TORRENTS="/mnt/tank/media/torrents"
TV_ADB_HOST="192.168.1.171:5555"
TV_MOONLIGHT_PKG="com.limelight"
TV_MOONLIGHT_ACTIVITY="com.limelight/.PcView"
TV_ADB_SERVER_BIN="/home/admin/.android-sdk/result/libexec/android-sdk/platform-tools/adb"

bold="" head="" reset="" dim=""
if [ -t 2 ]; then
    bold=$'\033[1m'
    head=$'\033[1;36m'
    dim=$'\033[2m'
    reset=$'\033[0m'
fi

_section() { printf '%s%s%s\n' "$head" "$1" "$reset" >&2; }
_row() { printf '  %s%-22s%s%s\n' "$bold" "$1" "$reset" "$2" >&2; }

_rows_setup() {
    _row "install"  "Move dotfiles to ~/.platform/dotfiles, stow configs, clone wallpapers"
    _row "rebuild"  "Rebuild and switch NixOS configuration"
    _row "update"   "Update flake inputs, push flake.lock, and rebuild"
    _row "push"     "Push local dotfiles commits to the remote"
    _row "pull"     "Pull the latest dotfiles commits from the remote"
}

_rows_wallpaper() {
    _row "wallpaper set <path>"   "Set the wallpaper and regenerate the pywal theme"
    _row "wallpaper random"       "Set a random wallpaper from ~/.wallpapers"
    _row "wallpaper restore"      "Restore the last-set wallpaper"
    _row "wallpaper warm"         "Pre-cache pywal colors for every wallpaper"
    _row "wallpaper recolor [file]" "Recolor a wallpaper (or the current one) into the active theme"
}

_rows_theme() {
    _row "theme list"       "List available themes"
    _row "theme current"    "Show the active theme (graphite if none is pinned)"
    _row "theme set <name>" "Pin a theme; survives wallpaper changes until 'theme auto'"
    _row "theme auto"       "Unpin, return to pure wallpaper-driven pywal colors"
}

_rows_secrets() {
    _row "secrets"               "List agenix secrets decryptable by this key/host"
    _row "secrets update <name>" "Edit/create a secret (opens \$EDITOR via agenix)"
}

_rows_remote() {
    _row "vm cyber-defence" "Connect to the cyber-defence VM hosted on server"
}

_rows_sync() {
    _row "sync on"     "Enable theme/wallpaper sync with the server hub on this machine"
    _row "sync off"    "Disable sync on this machine (no push, no pull)"
    _row "sync mode <unified|split>" "Set whether all devices share one theme or sync in two groups"
    _row "sync status" "Show sync state, mode, group, last push/pull times, and hub reachability"
}

_rows_torrent() {
    _row "torrent add <magnet>" "Add a torrent to qBittorrent (manual, category boner)"
    _row "torrent list"         "List manually added torrents with status"
    _row "torrent download"     "Copy a completed torrent to the current directory"
    _row "torrent remove <name>"  "Remove a torrent from qBittorrent and delete its files"
}

_rows_tv() {
    _row "cast" "Wake the TV and launch Moonlight"
}


# Per-subcommand usage, shown whenever that subcommand is called with a
# missing/unrecognized argument instead of a bare bash error.
_usage_wallpaper() {
    printf 'Usage: boner wallpaper %s<subcommand>%s [args]\n\n' "$dim" "$reset" >&2
    _rows_wallpaper
}

_usage_secrets() {
    printf 'Usage: boner secrets %s[update <name>]%s\n\n' "$dim" "$reset" >&2
    _rows_secrets
}

_usage_theme() {
    printf 'Usage: boner theme %s<subcommand>%s [args]\n\n' "$dim" "$reset" >&2
    _rows_theme
}

_usage_vm() {
    printf 'Usage: boner vm %s<name>%s\n\n' "$dim" "$reset" >&2
    _rows_remote
}

_usage_sync() {
    printf 'Usage: boner sync %s<on|off|mode|status>%s\n\n' "$dim" "$reset" >&2
    _rows_sync
}

_usage_torrent() {
    printf 'Usage: boner torrent %s<subcommand>%s [args]\n\n' "$dim" "$reset" >&2
    _rows_torrent
}


cmd_rebuild() {
    sudo nixos-rebuild switch --flake "$HOME/.platform/dotfiles/nixos#" --impure
}

cmd_update() {
    echo "Updating flake inputs..."
    nix flake update --flake "$DOTFILES_TARGET/nixos"

    if git -C "$DOTFILES_TARGET" diff --quiet -- nixos/flake.lock; then
        echo "flake.lock unchanged."
    else
        echo "Committing updated flake.lock..."
        git -C "$DOTFILES_TARGET" add nixos/flake.lock
        git -C "$DOTFILES_TARGET" commit -m "nixos: update flake.lock"
        git -C "$DOTFILES_TARGET" push
    fi

    cmd_rebuild
}

cmd_push() {
    git -C "$DOTFILES_TARGET" push
}

cmd_pull() {
    git -C "$DOTFILES_TARGET" pull
}

cmd_secrets() {
    local subcmd="${1:-list}"
    case "$subcmd" in
        update) cmd_secrets_update "${2:-}" ;;
        list) cmd_secrets_list ;;
        *)
            _usage_secrets
            exit 1
            ;;
    esac
}

cmd_secrets_list() {
    local rules="$DOTFILES_TARGET/nixos/secrets/secrets.nix"
    local admin_key host_key

    admin_key=$(awk -F': ' '/^# public key:/ {print $2}' "$HOME/.config/agenix/key.txt" 2>/dev/null || true)
    host_key=$(cut -d' ' -f1,2 /etc/ssh/ssh_host_ed25519_key.pub 2>/dev/null || true)

    nix eval --json --file "$rules" | jq -r \
        --arg admin "$admin_key" --arg host "$host_key" '
        to_entries[]
        | select(.value.publicKeys | index($admin) or index($host))
        | .key
        | sub("\\.age$"; "")
    '
}

cmd_secrets_update() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        _usage_secrets
        exit 1
    fi
    name="${name%.age}.age"
    local secret_file="$DOTFILES_TARGET/nixos/secrets/$name"
    local before after

    before=$(sha256sum "$secret_file" 2>/dev/null | cut -d' ' -f1 || true)

    case "$name" in
        git-credentials-*)
            echo "Format (whole line, not just the token):" >&2
            echo "  https://USERNAME:TOKEN@github.com" >&2
            echo "" >&2
            ;;
    esac

    (cd "$DOTFILES_TARGET/nixos/secrets" && nix run github:ryantm/agenix -- -e "$name" -i "$HOME/.config/agenix/key.txt")

    after=$(sha256sum "$secret_file" 2>/dev/null | cut -d' ' -f1 || true)

    if [ "$before" != "$after" ]; then
        echo "" >&2
        echo "$name changed -- commit it and run 'boner rebuild' for it to take effect." >&2
    fi
}

cmd_theme() {
    local subcmd="${1:-}"
    case "$subcmd" in
        list) cmd_theme_list ;;
        current) cmd_theme_current ;;
        set)
            shift
            if [ -z "${1:-}" ]; then
                _usage_theme
                exit 1
            fi
            # Absolute path, not PATH lookup: the theme files and the
            # shared theme-common.sh lib this sources both live in the
            # repo checkout, so this works right after `git pull` with
            # no rebuild needed (theme-set itself only needs a rebuild
            # to be reachable by *name* from Hyprland/Quickshell).
            exec "$DOTFILES_TARGET/scripts/theme-set" "$1"
            ;;
        auto) exec "$DOTFILES_TARGET/scripts/theme-auto" ;;
        *)
            _usage_theme
            exit 1
            ;;
    esac
}

cmd_theme_list() {
    # shellcheck source=lib/theme-common.sh
    . "$DOTFILES_TARGET/scripts/lib/theme-common.sh"
    theme_list
}

cmd_theme_current() {
    # shellcheck source=lib/theme-common.sh
    . "$DOTFILES_TARGET/scripts/lib/theme-common.sh"
    theme_active_name || echo graphite
}

cmd_sync() {
    local subcmd="${1:-}"
    case "$subcmd" in
        on) cmd_sync_on ;;
        off) cmd_sync_off ;;
        mode) cmd_sync_mode "${2:-}" ;;
        status) cmd_sync_status ;;
        *)
            _usage_sync
            exit 1
            ;;
    esac
}

cmd_sync_on() {
    # shellcheck source=lib/theme-sync-common.sh
    . "$DOTFILES_TARGET/scripts/lib/theme-sync-common.sh"
    theme_sync_set_enabled on
    echo "Theme/wallpaper sync enabled on this machine."
}

cmd_sync_off() {
    # shellcheck source=lib/theme-sync-common.sh
    . "$DOTFILES_TARGET/scripts/lib/theme-sync-common.sh"
    theme_sync_set_enabled off
    echo "Theme/wallpaper sync disabled on this machine."
}

cmd_sync_mode() {
    local mode="$1"
    case "$mode" in
        unified|split) ;;
        *)
            echo "Usage: boner sync mode <unified|split>" >&2
            exit 1
            ;;
    esac

    # shellcheck source=lib/theme-sync-common.sh
    . "$DOTFILES_TARGET/scripts/lib/theme-sync-common.sh"

    local hub_url
    hub_url=$(theme_sync_find_hub) || {
        echo "Error: hub unreachable (tried: $THEME_SYNC_HUB_URLS)." >&2
        exit 1
    }

    local response accepted_mode
    response=$(curl -sf --max-time 5 -X POST -H "Content-Type: application/json" -d "{\"mode\":\"$mode\"}" "$hub_url/mode" 2>/dev/null) || {
        echo "Error: failed to set mode on hub ($hub_url)." >&2
        exit 1
    }
    accepted_mode=$(printf '%s' "$response" | jq -r '.mode // ""')
    if [ "$accepted_mode" != "$mode" ]; then
        echo "Error: hub rejected mode '$mode' (response: $response)." >&2
        exit 1
    fi
    echo "Sync mode set to: $accepted_mode"
}

cmd_sync_status() {
    # shellcheck source=lib/theme-sync-common.sh
    . "$DOTFILES_TARGET/scripts/lib/theme-sync-common.sh"

    if theme_sync_enabled; then
        echo "sync: on"
    else
        echo "sync: off"
    fi
    echo "group: $THEME_SYNC_GROUP"

    if [ -f "$THEME_SYNC_STATE_FILE" ]; then
        local last_push last_pull
        last_push=$(jq -r '.last_push_at // 0' "$THEME_SYNC_STATE_FILE")
        last_pull=$(jq -r '.last_pull_at // 0' "$THEME_SYNC_STATE_FILE")
        if [ "$last_push" != 0 ]; then
            echo "last push: $(date -d "@$last_push")"
        fi
        if [ "$last_pull" != 0 ]; then
            echo "last pull: $(date -d "@$last_pull")"
        fi
    fi

    local hub_url
    if hub_url=$(theme_sync_find_hub); then
        echo "hub: $hub_url"
        local mode state_path
        mode=$(theme_sync_get_mode "$hub_url")
        echo "mode: $mode"
        state_path=$(theme_sync_state_path "$mode")
        curl -sf --max-time 2 "$hub_url/$state_path" | jq .
    else
        echo "hub: unreachable"
    fi
}

cmd_vm() {
    local name="${1:-}"
    local port

    if [ -z "$name" ]; then
        _usage_vm
        exit 1
    fi

    case "$name" in
        cyber-defence) port=5930 ;;
        windows-11)    port=5931 ;;
        *)
            echo "Unknown VM: $name" >&2
            echo >&2
            _usage_vm
            exit 1
            ;;
    esac

    echo "Connecting to $name via SPICE (192.168.1.2:$port)..."
    export GTK_THEME="Adwaita:dark"
    if command -v remote-viewer >/dev/null 2>&1; then
        exec remote-viewer "spice://192.168.1.2:${port}"
    else
        exec nix-shell -p virt-viewer --run "remote-viewer 'spice://192.168.1.2:${port}'"
    fi
}

cmd_wallpaper() {
    local subcmd="${1:-}"
    case "$subcmd" in
        # set/random/restore stay thin wrappers around the standalone
        # scripts instead of reimplementing them here: those are also
        # launched directly by Hyprland/Quickshell, where this script's
        # nix-shell shebang would add ~0.3-1s of pure startup overhead on
        # every wallpaper switch.
        set)
            shift
            if [ -z "${1:-}" ]; then
                _usage_wallpaper
                exit 1
            fi
            exec set-wallpaper "$@"
            ;;
        random)  exec random-wallpaper ;;
        restore) exec restore-wallpaper ;;
        warm)    cmd_wallpaper_warm ;;
        recolor)
            shift
            # Absolute path, not PATH lookup: same reasoning as `theme set`
            # above -- this works right after `git pull` with no rebuild.
            exec "$DOTFILES_TARGET/scripts/wallpaper-recolor" "$@"
            ;;
        *)
            _usage_wallpaper
            exit 1
            ;;
    esac
}

cmd_wallpaper_warm() {
    local wallpaper_dir="$HOME/.wallpapers"
    local total

    if [ ! -d "$wallpaper_dir" ]; then
        echo "No wallpapers found at $wallpaper_dir" >&2
        exit 1
    fi

    total=$(find "$wallpaper_dir" -type f \( \
        -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" \
    \) | wc -l)
    echo "Pre-caching pywal colors for up to $total wallpapers (already-cached ones are skipped fast)..."

    # wal already caches generated colorschemes per-image under
    # ~/.cache/wal/schemes/, keyed by path+size+backend. Priming that cache
    # ahead of time means set-wallpaper's own `wal -i` call hits it instead
    # of re-running color quantization, which is most of a wallpaper
    # switch's latency for a never-before-seen image. -n -s -t -e skip
    # every live side effect (wallpaper/terminal/tty/gtk reload), so this
    # is safe to run in the background without visibly touching anything.
    find "$wallpaper_dir" -type f \( \
        -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" -o -iname "*.webp" \
    \) -print0 | nice -n 10 xargs -0 -P "$(nproc)" -I{} wal -i "{}" -n -s -t -e -q

    echo "Done."
}

cmd_install() {
    if [ "$REPO_ROOT" != "$DOTFILES_TARGET" ]; then
        if [ -e "$DOTFILES_TARGET" ]; then
            echo "Error: $DOTFILES_TARGET already exists. Remove it first." >&2
            exit 1
        fi
        echo "Moving dotfiles to $DOTFILES_TARGET..."
        mv "$REPO_ROOT" "$DOTFILES_TARGET"
        exec "$DOTFILES_TARGET/scripts/boner" install
    fi

    echo "Stowing config files..."
    mkdir -p "$HOME/.config"
    stow --dir "$DOTFILES_TARGET" --target "$HOME/.config" config

    if [ ! -d "$HOME/.wallpapers" ]; then
        echo "Cloning wallpapers and pre-caching their pywal colors in the background (log: $HOME/.wallpapers-clone.log)..."
        nohup sh -c "git clone https://github.com/dharmx/walls.git '$HOME/.wallpapers' && '$DOTFILES_TARGET/scripts/boner' wallpaper warm" \
            >"$HOME/.wallpapers-clone.log" 2>&1 &
        disown
    else
        echo "$HOME/.wallpapers already exists, skipping clone."
    fi

    echo "Done."
}

# --- qBittorrent (manual torrents) ---

_qbit_read_secret() {
    # Sets QBIT_USER / QBIT_PASS from the agenix secret (two lines:
    # username on line 1, password on line 2).
    if [ ! -f "$QBIT_SECRET_FILE" ]; then
        echo "Error: qBittorrent credentials not found at $QBIT_SECRET_FILE." >&2
        echo "Run 'boner rebuild' so agenix decrypts the qbittorrent secret, then try again." >&2
        exit 1
    fi
    QBIT_USER=$(sed -n '1p' "$QBIT_SECRET_FILE")
    QBIT_PASS=$(sed -n '2p' "$QBIT_SECRET_FILE")
    if [ -z "$QBIT_USER" ] || [ -z "$QBIT_PASS" ]; then
        echo "Error: $QBIT_SECRET_FILE is empty or malformed (expected username on line 1, password on line 2)." >&2
        exit 1
    fi
}

_qbit_login() {
    # Logs in to the qBittorrent API. Tries the LAN address first, then
    # Tailscale, so it works on and off the home network. Sets QBIT_BASE
    # (working API root) and QBIT_COOKIE (session cookie file). The cookie
    # file is removed on exit.
    _qbit_read_secret
    QBIT_COOKIE=$(mktemp)
    trap 'rm -f "$QBIT_COOKIE"' EXIT
    local base code login_code
    for base in "${QBIT_HOSTS[@]}"; do
        # Any HTTP status (even 401) means the host answers; 000 means
        # unreachable.
        code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$base/api/v2/app/version" 2>/dev/null || echo "000")
        if [ "$code" = "000" ]; then
            continue
        fi
        login_code=$(curl -s --max-time 10 -o /dev/null -w '%{http_code}' -c "$QBIT_COOKIE" \
            --data-urlencode "username=$QBIT_USER" --data-urlencode "password=$QBIT_PASS" \
            "$base/api/v2/auth/login" 2>/dev/null || echo "000")
        if [ "$login_code" = "000" ]; then
            continue
        fi
        if [ "$login_code" = "200" ] || [ "$login_code" = "204" ]; then
            QBIT_BASE="$base"
            return 0
        fi
        echo "Error: qBittorrent login failed at $base (HTTP $login_code). Check the credentials in $QBIT_SECRET_FILE." >&2
        exit 1
    done
    echo "Error: could not reach qBittorrent at any of: ${QBIT_HOSTS[*]}." >&2
    exit 1
}

_magnet_hash() {
    # Extracts the btih info-hash from a magnet link (hex or base32).
    printf '%s' "$1" | sed -n 's/.*xt=urn:btih:\([A-Za-z0-9]*\).*/\1/p'
}

cmd_torrent() {
    local subcmd="${1:-}"
    case "$subcmd" in
        add)      cmd_torrent_add "${2:-}" ;;
        list)     cmd_torrent_list ;;
        download) cmd_torrent_download "${2:-}" ;;
        remove)   cmd_torrent_remove "${2:-}" ;;
        _complete) cmd_torrent_complete ;;
        _complete-all) cmd_torrent_complete_all ;;
        *)
            _usage_torrent
            exit 1
            ;;
    esac
}

cmd_torrent_add() {
    local magnet="${1:-}"
    if [ -z "$magnet" ]; then
        _usage_torrent
        exit 1
    fi
    _qbit_login
    local http_code
    http_code=$(curl -s --max-time 30 -b "$QBIT_COOKIE" -o /dev/null -w '%{http_code}' \
        --data-urlencode "urls=$magnet" \
        --data-urlencode "category=$QBIT_CATEGORY" \
        --data-urlencode "savepath=$QBIT_MANUAL_SAVEPATH" \
        "$QBIT_BASE/api/v2/torrents/add" 2>/dev/null || echo "000")
    if [ "$http_code" != "200" ]; then
        echo "Error: qBittorrent rejected the torrent (HTTP $http_code)." >&2
        exit 1
    fi
    local hash name i
    hash=$(_magnet_hash "$magnet")
    # The torrent may take a moment to appear; retry briefly for its name.
    name=""
    for i in 1 2 3 4 5; do
        name=$(curl -s --max-time 10 -b "$QBIT_COOKIE" "$QBIT_BASE/api/v2/torrents/info?hashes=$hash" 2>/dev/null | jq -r '.[0].name // empty')
        if [ -n "$name" ]; then
            break
        fi
        sleep 1
    done
    if [ -n "$name" ]; then
        echo "Added: $name"
    else
        echo "Added torrent $hash (name not visible yet)."
    fi
}

cmd_torrent_list() {
    _qbit_login
    local json count
    json=$(curl -s --max-time 15 -b "$QBIT_COOKIE" "$QBIT_BASE/api/v2/torrents/info?category=$QBIT_CATEGORY")
    count=$(printf '%s' "$json" | jq 'length')
    if [ "$count" = "0" ]; then
        echo "No manually added torrents (category '$QBIT_CATEGORY')."
        return 0
    fi
    printf '%s' "$json" | jq -r '
        def human: if . >= 1073741824 then ((./1073741824*10|floor)/10|tostring)+" GiB" elif . >= 1048576 then ((./1048576*10|floor)/10|tostring)+" MiB" elif . >= 1024 then ((./1024*10|floor)/10|tostring)+" KiB" else (tostring+" B") end;
        def rate: (human + "/s");
        (["NAME","SIZE","PROGRESS","STATE","SEEDS","DL","UP"] | @tsv),
        (.[] | [(.name | .[0:55]), (.size | human), ((.progress*100|floor|tostring)+"%"), .state, (.num_seeds | tostring), (.dlspeed | rate), (.upspeed | rate)] | @tsv)
    ' | column -t -s "$(printf '\t')"
}

# Hidden helper for shell completion: prints the names of all manual
# torrents, one per line, for `boner torrent remove` tab completion.
# Not shown in usage.
cmd_torrent_complete_all() {
    _qbit_login
    local json
    json=$(curl -s --max-time 15 -b "$QBIT_COOKIE" "$QBIT_BASE/api/v2/torrents/info?category=$QBIT_CATEGORY")
    printf '%s' "$json" | jq -r '.[] | .name'
}

# Hidden helper for shell completion: prints the names of completed
# manual torrents, one per line, for `boner torrent download` tab
# completion. Not shown in usage.
cmd_torrent_complete() {
    _qbit_login
    local json
    json=$(curl -s --max-time 15 -b "$QBIT_COOKIE" "$QBIT_BASE/api/v2/torrents/info?category=$QBIT_CATEGORY")
    printf '%s' "$json" | jq -r '.[] | select(.progress >= 1) | .name'
}

cmd_torrent_download() {
    local query="${1:-}"
    if [ -z "$query" ]; then
        _usage_torrent
        exit 1
    fi
    _qbit_login
    local json match
    json=$(curl -s --max-time 15 -b "$QBIT_COOKIE" "$QBIT_BASE/api/v2/torrents/info?category=$QBIT_CATEGORY")
    match=$(printf '%s' "$json" | jq -r --arg q "$query" '
        map(select((.name | ascii_downcase | contains($q | ascii_downcase)) or (.hash | startswith($q))))
        | .[0] // empty')
    if [ -z "$match" ]; then
        echo "Error: no manual torrent matching '$query'." >&2
        exit 1
    fi
    local hash name progress complete pct content_path save_path
    hash=$(printf '%s' "$match" | jq -r '.hash')
    name=$(printf '%s' "$match" | jq -r '.name')
    progress=$(printf '%s' "$match" | jq -r '.progress')
    complete=$(printf '%s' "$match" | jq -r '.progress >= 1')
    content_path=$(printf '%s' "$match" | jq -r '.content_path // empty')
    save_path=$(printf '%s' "$match" | jq -r '.save_path')
    if [ "$complete" != "true" ]; then
        pct=$(printf '%s' "$match" | jq -r '(.progress*100|floor)')
        echo "Error: '$name' is not complete yet ($pct%). Wait for it to finish." >&2
        exit 1
    fi
    # Resolve the content path (container path) and translate it to the
    # host path. content_path is the file for single-file torrents and the
    # directory for multi-file ones.
    local container_path host_path
    if [ -n "$content_path" ]; then
        container_path="$content_path"
    else
        container_path="$save_path/$name"
    fi
    host_path="$QBIT_HOST_TORRENTS/${container_path#$QBIT_CONTAINER_TORRENTS/}"
    echo "Copying '$name' from the server to $PWD/ ..."
    rsync -av --progress --human-readable --protect-args "admin@server:$host_path" "./"
    echo "Done. The server copy stays in place (still seeding)."
}

cmd_torrent_remove() {
    local query="${1:-}"
    if [ -z "$query" ]; then
        _usage_torrent
        exit 1
    fi
    _qbit_login
    local json match
    json=$(curl -s --max-time 15 -b "$QBIT_COOKIE" "$QBIT_BASE/api/v2/torrents/info?category=$QBIT_CATEGORY")
    match=$(printf '%s' "$json" | jq -r --arg q "$query" '
        map(select((.name | ascii_downcase | contains($q | ascii_downcase)) or (.hash | startswith($q))))
        | .[0] // empty')
    if [ -z "$match" ]; then
        echo "Error: no manual torrent matching '$query'." >&2
        exit 1
    fi
    local hash name
    hash=$(printf '%s' "$match" | jq -r '.hash')
    name=$(printf '%s' "$match" | jq -r '.name')
    printf 'Remove "%s" from qBittorrent and DELETE its files from the server? [y/N] ' "$name"
    local ans
    read -r ans
    case "$ans" in
        [yY]|[yY][eE][sS]) ;;
        *) echo "Cancelled."; return 0 ;;
    esac
    local http_code
    http_code=$(curl -s --max-time 30 -b "$QBIT_COOKIE" -o /dev/null -w '%{http_code}' \
        --data-urlencode "hashes=$hash" \
        --data-urlencode "deleteFiles=true" \
        "$QBIT_BASE/api/v2/torrents/delete" 2>/dev/null || echo "000")
    if [ "$http_code" != "200" ]; then
        echo "Error: qBittorrent refused the remove (HTTP $http_code)." >&2
        exit 1
    fi
    echo "Removed: $name (torrent and files deleted from the server)."
}

# --- TV cast ---

_adb() {
    # Runs adb: a local binary first, the server's copy if we are on the
    # server, otherwise adb on the server over SSH.
    if command -v adb >/dev/null 2>&1; then
        adb "$@"
    elif [ -x "$TV_ADB_SERVER_BIN" ]; then
        "$TV_ADB_SERVER_BIN" "$@"
    else
        ssh admin@server "$TV_ADB_SERVER_BIN" "$@"
    fi
}

_tv_moonlight_foreground() {
    # True when Moonlight is the focused app on the TV (not merely running).
    _adb -s "$TV_ADB_HOST" shell dumpsys window 2>/dev/null | grep -qi "mCurrentFocus=.*$TV_MOONLIGHT_PKG"
}

cmd_cast() {
    local attempt connected=0
    echo "Connecting to the TV at $TV_ADB_HOST ..."
    for attempt in 1 2 3 4 5; do
        if _adb connect "$TV_ADB_HOST" 2>&1 | grep -qi 'connected\|already connected'; then
            connected=1
            break
        fi
        sleep 3
    done
    if [ "$connected" != "1" ]; then
        echo "Error: could not connect to the TV at $TV_ADB_HOST after 5 tries. Is it on and on the network?" >&2
        exit 1
    fi
    _adb -s "$TV_ADB_HOST" shell input keyevent KEYCODE_WAKEUP
    sleep 2
    # Primary: explicit activity launch. Note: am start launches Moonlight
    # but does not always bring it to the foreground, so verify focus.
    _adb -s "$TV_ADB_HOST" shell am start -n "$TV_MOONLIGHT_ACTIVITY" >/dev/null 2>&1
    sleep 3
    if _tv_moonlight_foreground; then
        echo "Moonlight is launching on the TV."
        return 0
    fi
    # Fallback: launcher intent, which reliably brings it to the foreground.
    _adb -s "$TV_ADB_HOST" shell monkey -p "$TV_MOONLIGHT_PKG" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1
    sleep 3
    if _tv_moonlight_foreground; then
        echo "Moonlight is launching on the TV (via launcher intent)."
        return 0
    fi
    echo "Error: Moonlight did not come to the foreground on the TV." >&2
    exit 1
}


print_usage() {
    printf '%sboner%s - dotfiles management\n\n' "$bold" "$reset" >&2
    printf 'Usage: boner %s<command>%s [args]\n\n' "$dim" "$reset" >&2

    _section "Setup"
    _rows_setup
    echo >&2

    _section "Wallpaper"
    _rows_wallpaper
    echo >&2

    _section "Theme"
    _rows_theme
    echo >&2

    _section "Secrets"
    _rows_secrets
    echo >&2

    _section "Remote"
    _rows_remote
    echo >&2

    _section "Sync"
    _rows_sync
    echo >&2

    _section "Torrents"
    _rows_torrent
    echo >&2

    _section "TV"
    _rows_tv
}

case "${1:-}" in
    install) cmd_install ;;
    rebuild) cmd_rebuild ;;
    update) cmd_update ;;
    push) cmd_push ;;
    pull) cmd_pull ;;
    secrets) cmd_secrets "${@:2}" ;;
    vm) cmd_vm "${@:2}" ;;
    wallpaper) cmd_wallpaper "${@:2}" ;;
    theme) cmd_theme "${@:2}" ;;
    sync) cmd_sync "${@:2}" ;;
    torrent) cmd_torrent "${@:2}" ;;
    cast) cmd_cast ;;
    help|-h|--help) print_usage ;;
    *)
        print_usage
        exit 1
        ;;
esac
