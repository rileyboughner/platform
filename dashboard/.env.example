# Home Assistant long-lived access token: create one in HA under
# Profile > Security > Long-Lived Access Tokens, then paste it here.
# Leave empty to show an honest empty state instead of guessing/reusing
# another token.
HA_TOKEN=

# Optional overrides -- defaults in docker-compose.yml already match the
# current homelab layout, only set these if something moves.
HA_URL=
JELLYFIN_URL=
JELLYFIN_USERNAME=
SEERR_URL=
CADVISOR_URL=
