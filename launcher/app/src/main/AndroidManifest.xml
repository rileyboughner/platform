<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to enumerate installed launchable apps for the app grid. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Todo page: Todoist REST API calls. Also covers the theme-sync hub
         client (dev.rileyboughner.launcher.theme.ThemeSyncRepository). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Theme-sync hub client: applies a wallpaper pulled from the hub via
         WallpaperManager.setBitmap. Normal permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Phone main page: in-app update check + install (see launcher/UPDATES.md).
         Still requires the per-app "Allow from this source" grant at runtime
         (PackageManager.canRequestPackageInstalls), prompted for in-app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Calendar page: read-only device calendar, requested at runtime. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Main-page glance block: Health Connect sleep sessions (read-only,
         requested via the Health Connect permission contract — see
         SettingsScreen/HealthConnectRepository) and the special "usage
         access" grant for today's screen time (no runtime dialog; user
         enables it by hand in system Settings). -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- TV universal Home Assistant popup (HaPopupAccessibilityService):
         draws its lights/scenes overlay as a TYPE_APPLICATION_OVERLAY
         window, which requires this permission plus the one-time "Appear
         on top" grant in system Settings (not a runtime dialog). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Required so HealthConnectClient can even detect the Health Connect
         provider app under API 30+ package-visibility filtering (targetSdk
         34 here) — without this, isAvailable()/getSdkStatus() reports the
         SDK unavailable and the grant flow in SettingsScreen never shows,
         regardless of the READ_SLEEP permission above being declared.
         Both the legacy Health Connect APK (healthdata) and the newer
         Health Connect app package name (healthconnect.controller) are
         queried since different OEM/Android versions ship it under either
         package name. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.google.android.healthconnect.controller" />
    </queries>

    <!-- Declared so this APK is installable on a phone/tablet without
         Leanback (feature is optional, matching the Google TV entry point
         below also being optional on handheld devices). -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:theme="@style/Theme.Launcher">

        <!-- The *only* HOME candidate in this manifest — see
             HomeRouterActivity's kdoc for the incident (TV stuck on the
             phone UI) that made MainActivity/TvMainActivity declaring their
             own HOME category unsafe. Routes to the correct activity below
             based on UiModeManager at runtime, then finishes invisibly. -->
        <activity
            android:name=".HomeRouterActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Phone / tablet entry point. Reached only via HomeRouterActivity
             on a real HOME press, or directly from an app drawer (LAUNCHER
             category below, for development). Uses the wallpaper-showing
             theme variant (see themes.xml) so the Apps page can show the
             real system wallpaper; SettingsActivity and TvMainActivity below
             stay on the plain opaque Theme.Launcher. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Launcher.Wallpaper"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings screen: reached only by tapping the page-dot strip at
             the bottom of the pager, to paste in a Todoist API token. Not a
             launcher entry point, not exported. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Launcher" />

        <!-- Health Connect privacy-policy / rationale screen: Health Connect
             shows the permission sheet only when the app declares an activity
             for ACTION_SHOW_PERMISSIONS_RATIONALE (through Android 13) plus
             the VIEW_PERMISSION_USAGE alias (Android 14+, platform Health
             Connect). Both open PermissionsRationaleActivity, which states
             what sleep data is read and that it never leaves the device. -->
        <activity
            android:name=".PermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.Launcher">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Google TV / Android TV entry point. Reached only via
             HomeRouterActivity on a real HOME press, or directly from the
             Android TV apps row (LEANBACK_LAUNCHER category below, for
             development). Separate activity so the TV "10-foot" Compose UI
             never loads on phone/tablet, and vice versa. -->
        <activity
            android:name=".TvMainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- TV universal Home Assistant popup — see HaPopupAccessibilityService's
             kdoc for the exact one-time setup (Accessibility + "Appear on
             top", both manual, nothing here auto-enables either). Disabled
             by default like any accessibility service; exported="true" is
             required for the system to bind it, but the
             BIND_ACCESSIBILITY_SERVICE permission check means only the
             system itself can actually do so. -->
        <service
            android:name=".accessibility.HaPopupAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/ha_popup_accessibility_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ha_popup_accessibility_service" />
        </service>

        <!-- Hands the downloaded update APK (in app cache) to the system
             installer as a content:// URI — see UpdateInstaller. Only ever
             used from MainActivity's update flow. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
