<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      System (pre-Compose) activity theme. Compose UI is themed in Kotlin via
      AppTheme.kt, which reads colors straight from the generated
      PlatformTheme object (theme/build/android/Theme.kt) — nothing here
      duplicates a color value, @color/color_semantic_background is the
      resource AAPT merges in from theme/build/android/colors.xml via the
      syncThemeColors Gradle task (see app/build.gradle.kts).
    -->
    <style name="Theme.Launcher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/color_semantic_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!--
      MainActivity only. Lets the system compositor draw the real device
      wallpaper (including live wallpapers) directly behind this window,
      instead of this app reading WallpaperManager's drawable into a Bitmap
      itself — that read came back null on Riley's Pixel, so the Apps page
      was solid black. android:windowIsTranslucent is required alongside
      windowShowWallpaper: without it the opaque windowBackground below
      still paints over the wallpaper surface. The Apps page (AppsPageScreen)
      is the only pager page that leaves part of the window undrawn (behind
      its dark scrim) for this to show through — every other page paints
      its own fully opaque background on top, so they stay solid black
      unaffected by this theme change.

      Also overrides windowFullscreen back to false (v8 regression): that
      legacy pre-insets-API attribute hides the status bar at the
      WindowManager.LayoutParams level, which the Android docs warn against
      combining with WindowInsetsController/decorFitsSystemWindows — in
      practice it fought the insets controller and left a solid opaque
      status-bar-height band on screen instead of either fully hiding the
      bar or letting content draw through it. statusBarColor/navigationBarColor
      transparent plus windowLayoutInDisplayCutoutMode=shortEdges below are
      the modern replacement: bars stay shown but transparent, and content
      (plus the cutout area) draws underneath them edge-to-edge.
    -->
    <style name="Theme.Launcher.Wallpaper" parent="Theme.Launcher">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
