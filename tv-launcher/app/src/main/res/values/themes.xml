<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System (pre-Compose) activity theme: pure black window, fullscreen,
         no title. Compose UI is themed in Kotlin via TvTheme. -->
    <style name="Theme.TvLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
