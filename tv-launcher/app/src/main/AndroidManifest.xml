<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to resolve the Leanback launch intents for Jellyfin/YouTube. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Home Assistant REST API, theme-sync hub, token server, update check. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- In-app update check + install (see tv-launcher/UPDATES.md). Still
         requires the per-app "Allow from this source" grant at runtime. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- TV-only app: Leanback is required, touchscreen is not. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.TvLauncher">

        <!-- The only entry point. HOME makes this a launcher candidate;
             LEANBACK_LAUNCHER puts it in the Android TV apps row. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TvLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the downloaded update APK (in app cache) to the system
             installer as a content:// URI — see UpdateInstaller. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
